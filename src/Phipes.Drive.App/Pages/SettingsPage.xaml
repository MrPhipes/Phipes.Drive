<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Phipes.Drive.App.Pages.SettingsPage"
             Title="Ajustes">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Border BackgroundColor="White"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 10"
                    Padding="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Cuenta" FontAttributes="Bold" />
                    <Label x:Name="AccountLabel" TextColor="{StaticResource TextMuted}" FontSize="13" />
                    <Label x:Name="ServerLabel" TextColor="{StaticResource TextMuted}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 10"
                    Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Solo WiFi" FontAttributes="Bold" />
                        <Label Text="Respaldar únicamente con conexión WiFi"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="13" />
                    </VerticalStackLayout>
                    <Switch x:Name="WifiOnlySwitch"
                            Grid.Column="1"
                            OnColor="{StaticResource Accent}"
                            Toggled="OnWifiOnlyToggled" />
                </Grid>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#DDE3EA"
                    StrokeShape="RoundRectangle 10"
                    Padding="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Respaldo automático" FontAttributes="Bold" />
                    <Label Text="El respaldo se ejecuta en segundo plano aproximadamente cada hora cuando hay red permitida. Android puede espaciarlo para ahorrar batería."
                           TextColor="{StaticResource TextMuted}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Cerrar sesión"
                    BackgroundColor="{StaticResource Danger}"
                    Clicked="OnLogoutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
