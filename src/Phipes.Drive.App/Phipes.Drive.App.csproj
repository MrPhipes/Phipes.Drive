<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android is the primary target. The iOS target is declared for future work but
         requires a macOS host with the maui-ios workload, so it is only activated there. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Phipes.Drive.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Phipes Drive</ApplicationTitle>
    <ApplicationId>cl.phipes.drive.app</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- Android 10+ (API 29) so MediaStore relative paths are available. -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Release signing. Point PhipesKeyStore at your own keystore (never commit one) and
       supply the passwords out of band, e.g.:
         dotnet publish ... -p:PhipesKeyStore=<path> -p:PhipesKeyStorePass=<pass>
       Debug builds keep the default debug signature. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(PhipesKeyStore)' != '' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(PhipesKeyStore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(PhipesKeyAlias)' != ''">$(PhipesKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyAlias Condition="'$(PhipesKeyAlias)' == ''">phipes-drive</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>$(PhipesKeyStorePass)</AndroidSigningStorePass>
    <AndroidSigningKeyPass>$(PhipesKeyStorePass)</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1565C0" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1565C0" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- WorkManager for the periodic background backup. -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.5" />
  </ItemGroup>

</Project>
